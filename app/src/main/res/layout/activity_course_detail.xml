<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDetailCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course Placement Report"
            android:textColor="#1A237E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#F1F3F9"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvDetailPlaced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Placed: 0%"
                    android:textSize="16sp"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDetailStudents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Students: 0"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvDetailHighest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Highest: 0 LPA"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvDetailAverage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average: 0 LPA"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top Recruiting Companies:"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/tvDetailCompanies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Company names"
            android:layout_marginTop="6dp"
            android:textColor="#065709"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overall Campus Stats:"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="*Overall Placement of last year - 86%"
            android:layout_marginTop="6dp"
            android:textStyle="bold"
            android:textColor="#1A237E"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Required for placement:"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFF9C4"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Aptitude &amp; Logical Test" android:textColor="#1A237E" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Coding Round, Gaming Round" android:textColor="#1A237E" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Group Discussion (GD)" android:textColor="#1A237E" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Technical Interview, Personal Interview" android:textColor="#1A237E" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• HR Interview &amp; Offer" android:textColor="#1A237E" android:textStyle="bold"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>