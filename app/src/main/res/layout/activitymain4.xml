                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Block 1" android:textColor="#FFFFFF" android:layout_margin="12dp" android:textStyle="bold" android:background="@drawable/glass_bg" android:paddingHorizontal="12dp" android:paddingVertical="4dp"/>
