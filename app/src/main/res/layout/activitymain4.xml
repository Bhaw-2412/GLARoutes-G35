                        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <ImageView android:id="@+id/imgB1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/b1" />
