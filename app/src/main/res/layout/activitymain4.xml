                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="24dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Academic Blocks (B1 - B2)" android:textColor="#C5CAE9" android:textStyle="bold" android:layout_marginBottom="12dp"/>
